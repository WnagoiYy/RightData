[Unit]
Description=RightData backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rightdata
Group=rightdata
WorkingDirectory=/opt/rightdata/current
EnvironmentFile=/etc/rightdata/server.env
ExecStart=/opt/rightdata/current/rightdata
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/rightdata
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
